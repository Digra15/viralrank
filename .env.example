# --- 9Router (AI layer: provider ag + Claude) ---
NINE_ROUTER_BASE=http://localhost:20128/v1
NINE_ROUTER_KEY=
AI_MODELS=ag/claude-sonnet-4-6,ag/claude-opus-4-6-thinking,ag/gemini-3.8-flash

